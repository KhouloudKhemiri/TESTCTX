    </OnInit>
</Text>

  <Text Position="2" Label="" ColTable="CPTCLE66P" Nom="CPTCLE66P" Type="Numerique" Longueur="1" Disabled="Oui"  Unique="Oui" >
      <OnInit>
			    <Requet Tables="FL1066_TEMP_64" >
