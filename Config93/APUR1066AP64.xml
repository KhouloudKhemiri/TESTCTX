					 <Select Nom="AGC" Type="AlphaNumerique" ColTable="distinct CPTAGC66T"/>
				  </Requet>

				  <Result>
          <![CDATA[  
               %THIS0301%=%AGC%;
               ]]> 
         </Result>
    </OnInit>
</Text>

  <Text Position="2" Label="" ColTable="CPTNAT66P" Nom="CPTNAT66P" Type="Numerique" Longueur="2" Disabled="Oui"  Unique="Oui" >
      <OnInit>
			    <Requet Tables="FL1066_TEMP_64" >
