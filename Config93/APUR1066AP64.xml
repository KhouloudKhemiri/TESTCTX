               %THIS0302%=%NAT%;
               ]]> 
         </Result>
    </OnInit>
</Text>

  <Text Position="2" Label="" ColTable="CPTORD66P" Nom="CPTORD66P" Type="Numerique" Longueur="5" Disabled="Oui"  Unique="Oui" >
