				  </Requet>
				  <Result>
          <![CDATA[  
               %THIS0304%=%CLE%;
               ]]> 
         </Result>
    </OnInit>
</Text>


  <Text Position="NLigne" Label="Code engagement" ColTable="ENGOPE66P" Nom="ENGOPE66P" Type="AlphaNumerique" Longueur="3" Disabled="Oui"  Unique="Oui" >
      <OnInit>
			    <Requet Tables="FL1066_TEMP_64" >
					 <Select Nom="ENG" Type="Numerique" ColTable="distinct ENGOPE66T"/>
				  </Requet>
          <Requet Tables="FL1030" Where=" CODAGC1030='%THIS0301%' and CODNAT1030='%THIS0302%' and ORDCPT1030='%THIS0303%' and KLECPT1030='%THIS0304%' " >
					  <Select Nom="NOMCPT" Type="AlphaNumerique" ColTable="NOMRSC"/>					           
					  <Select Nom="SRVCPT" Type="AlphaNumerique" ColTable="SRVCPT10"/>            
				  </Requet>
  			    <Requet Tables="FL1066_AAPUR_64" Where=" CPTAGC66A='%THIS0301%' and CPTNAT66A='%THIS0302%' and CPTORD66A='%THIS0303%' and CPTCLE66A='%THIS0304%' and SU1066A=0" >
					    <Select Nom="NBRINS" Type="AlphaNumerique" ColTable="NBRINS66A"/>            
		  		  </Requet>

				  <Result>
          <![CDATA[  
               int SRV;
               if (%SRVCPT%.compareTo("null")==0)
               {
                    SRV = 0;
               }
               if (%SRVCPT%.compareTo("0")==0)
               {
                    SRV = 0;
               }
               if (%SRVCPT%.compareTo("1")==0)
               {
                    SRV = 1;
               }
               if (SRV !=  0)
               {
                 %THIS0306%="Attention le compte du client CTX est sous code surveillance";
               } else
               {
                  %THIS0306%="";
               }
               %THIS0305%=%ENG%;
               %THIS0307%=%NOMCPT%;
               if (%THIS0305%.compareTo("")!=0)
               {
               %THIS0308%="Nombre d'Instances à valider = " + %NBRINS%;
               }

               ]]> 
         </Result>
    </OnInit>
</Text>

   <SimpleText Position="2" Label="" Valeur="" />
   <Text Position="NLigne" Label="Nom et Prénom ou R/S" ColTable="" Nom="" Type="AlphaNumerique" Longueur="30" Disabled="Oui" Unique="Non"/> 
   <SimpleText Position="NLigne" Label="" Valeur="" />

