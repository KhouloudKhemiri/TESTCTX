			    <Requet Tables="FL5503" Where=" CODAGC5503='%THIS050007%' " >
					  <Select Nom="NBRAGC" Type="AlphaNumerique" ColTable="'0'||count(*)"/>
				  </Requet>
          
				  <Result>          
             if(Integer.parseInt(%NBRAGC%.trim())==0)
							{
                 %THIS050007%="ERREUR: Agence Inexistante" ;
              } 
              %THIS050010% = "";
				  </Result>
