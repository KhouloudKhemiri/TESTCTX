	<Text Position="2" Label="" ColTable="NAXOPE3002" Nom="NAXOPE3002" Type="Numerique" Longueur="2" Unique="Non" Obligatoire="Oui" PositionCel="5" LongueurCel="5" LabelCel="Nat cpt client">
      <OnUpdate>
				<Result>
						 if ((%THIS050008%.compareTo("03")==0) || (%THIS050008%.compareTo("04")==0) || (%THIS050008%.compareTo("05")==0) || (%THIS050008%.compareTo("06")==0))
             {
             }else
             { %THIS050008%="ERREUR: Nature doit etre = 03, 04, 05 ou 06";
             }
              %THIS050010% = "";
				</Result>
 		  </OnUpdate>
  </Text>
  
	<Text Position="2" Label="" ColTable="ORXOPE3002" Nom="ORXOPE3002" Type="Numerique" Longueur="5" Unique="Non" Obligatoire="Oui" PositionCel="6" LongueurCel="5" LabelCel="Ord cpt client">
