	<Text Position="2" Label="" ColTable="KLXOPE3002" Nom="KLXOPE3002" Type="Numerique" Longueur="1" Unique="Non" Obligatoire="Oui" PositionCel="7" LongueurCel="6" LabelCel="Clé Cpt">

      <OnInit>
			    <Requet Tables="FL1030" Where=" CODAGC1030='%THIS050007%' and CODNAT1030='%THIS050008%' and ORDCPT1030='%THIS050009%' and KLECPT1030='%THIS050010%' " >
					  <Select Nom="NBRCPT" Type="AlphaNumerique" ColTable="'0'||count(*)"/>
				  </Requet>

			    <Requet Tables="FL1030" Where=" CODAGC1030='%THIS050007%' and CODNAT1030='%THIS050008%' and ORDCPT1030='%THIS050009%' and KLECPT1030='%THIS050010%' " >
					  <Select Nom="NOMCPT" Type="AlphaNumerique" ColTable="NOMRSC"/>
					  <Select Nom="SLDCPT" Type="AlphaNumerique" ColTable="SLDCPT10"/>            
					  <Select Nom="CODCLO" Type="AlphaNumerique" ColTable="CODCLO10"/>            
					  <Select Nom="SRVCPT" Type="AlphaNumerique" ColTable="SRVCPT10"/>            
				  </Requet>
          <Requet Tables="FL1066" Where=" (AGCNUM66 || SERNUM66 || ORDNUM66)=('%THIS050004%' || '%THIS050005%' || TO_NUMBER('%THIS050006%')) and CPTAGC66='%THIS050007%' and CPTNAT66='%THIS050008%' and CPTORD66='%THIS050009%' and CPTCLE66='%THIS050010%' " > 
					  <Select Nom="NBRC" Type="AlphaNumerique" ColTable="'0'||count(*)"/>
				  </Requet>

				  <Result>
          <![CDATA[  
             if(%THIS050010%.equals("") )
             {
             return;
             }
              if (Integer.parseInt(%NBRCPT%.trim())==0)
							{
                %THIS050010%="ERREUR: Compte Inexistant  ";
                return;
              }
              
          
              if (Integer.parseInt(%NBRC%.trim())==0)
							{
                %THIS050010%="ERREUR: Compte erroné  ";
              } else
              {
                public static String replaceNull(String input) {
                return input == null ? "" : input;
                }
                int CLO, SRV;
 
                if (replaceNull(%CODCLO%) == "")
                {
                  CLO = 0;
                } else
                {             
                  if (Integer.parseInt(replaceNull(%CODCLO%).trim()) == 0)
                  {
                    CLO = 0;
                  } else
                  {
                    CLO = 1;
                  }
                }                 

                if (replaceNull(%SRVCPT%) == "")
                {
                  SRV = 0;
                } else
                {             
                  if (Integer.parseInt(replaceNull(%SRVCPT%).trim()) == 0)
                  {
                    SRV = 0;
                  } else
                  {
                    SRV = 1;
                  }
                }                 

                if (CLO !=  0)
                {
                  %THIS050010%="ERREUR: Compte cloturé";
                } else
                {
                  if (SRV !=  0)
                  {
                    %THIS050011%="Attention le compte du client CTX est sous code surveillance";
                  } else
                  {
                     %THIS050011%="";
                  }
                             
			      	       %THIS050012%= %NOMCPT%;
                     %THIS050021%= %SLDCPT%;
                     %THIS050022%= %SLDCPT%;            
                   
                }
              }
               ]]> 
         </Result>
    </OnInit>

  </Text>

