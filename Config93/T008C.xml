        <Result>
          <![CDATA[
                     int p = %THIS0107%.indexOf("+");
                     int m = %THIS0107%.indexOf("-");
                     int e = %THIS0107%.indexOf("*");
                     int d = %THIS0107%.indexOf("/");

                     if ((p != -1) || (m != -1) || (e != -1) || (d != -1))
                     {
                      %THIS0107%="ERREUR: Montant erroné";
                      return;
                     }

             if (Integer.parseInt(%INSACT%.trim())==0)
