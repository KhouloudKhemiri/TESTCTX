	<queryString>
		<![CDATA[SELECT CODAGC03, DATOPE03, AGCNUM03 || ' ' || SERNUM03 || ' ' || lpad (ORDNUM03,7,'0'),ENGOPE03, MNTOPE03, INSMEG03, AG1OPE03,
AG1OPE03 || '-' || lpad (NA1OPE03,2,'0') || '-' ||
lpad (OR1OPE03,5,'0') || '-' || KL1OPE03 , NOMCPT03, LIBOPE03, ECHOPE03, ACCEFF03, AGYOPE03,
TYPESC03, LIB5503
FROM FL1003,FL5503
WHERE SU1003=0 and CODAGC5503 = AG1OPE03
ORDER BY INSMEG03, AG1OPE03, AGCMEG03, CODAGC03, DATOPE03, CODOPE03, AGCNUM03, SERNUM03, ORDNUM03]]>
	</queryString>
