	<queryString>
		<![CDATA[SELECT CPTAGC71 || '-' || lpad (CPTNAT71,2,'0') || '-' ||
       lpad (CPTORD71,5,'0') || '-' || CPTCLE71,
       DATCRE71,NOMCPT71,AGCNUM71 || ' ' || SERNUM71 || ' ' ||
       lpad (ORDNUM71,7,'0'),ENGOPE71,MNTOPE71 , CPTAGC71, LIB5503
FROM FL1071,FL5503
WHERE SU1071 = 0 and CODAGC5503 = CPTAGC71
ORDER BY CPTAGC71, CPTNAT71, CPTORD71, CPTCLE71, DATCRE71]]>
	</queryString>
	<field name="CPTAGC71||-||LPAD(CPTNAT71,2,0)||-||LPAD(CPTORD71,5,0)||-||CPTCLE71" class="java.lang.String"/>
