	<field name="NOMRSC" class="java.lang.String"/>
	<field name="LIBOPE" class="java.lang.String"/>
	<variable name="LIBOPE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{LIBOPE}]]></variableExpression>
	</variable>
	<variable name="EMT" class="java.lang.String">
		<variableExpression><![CDATA[($F{CODOPE3002}.equals("T036") || $F{CODOPE3002}.equals("T039")) ? $F{AGYOPE3002} : (($F{CODOPE3002}.equals("T037") || $F{CODOPE3002}.equals("T040")) ? "93" : (($F{CODOPE3002}.equals("T059") || $F{CODOPE3002}.equals("T060") || $F{CODOPE3002}.equals("T061") || $F{CODOPE3002}.equals("T062")) ? $F{AGXOPE3002} : "" ))]]></variableExpression>
	</variable>
	<variable name="REC" class="java.lang.String">
		<variableExpression><![CDATA[($F{CODOPE3002}.equals("T036") || $F{CODOPE3002}.equals("T039")) ? $F{AGZREC3002} : (($F{CODOPE3002}.equals("T037") || $F{CODOPE3002}.equals("T040")) ? $F{MEGOPE3002} : (($F{CODOPE3002}.equals("T059") || $F{CODOPE3002}.equals("T060") || $F{CODOPE3002}.equals("T061") || $F{CODOPE3002}.equals("T062")) ? "93" : "" ))]]></variableExpression>
	</variable>
