	<queryString>
		<![CDATA[(SELECT DATOPE3002, CATOPE3002, CODOPE3002, AGCNUM3002 || ' ' || SERNUM3002 || ' ' ||
lpad (ORDNUM3002,7,'0'),
CASE  WHEN (NAXOPE3002='' or NAXOPE3002 is null) THEN (AGXOPE3002 || '-' || '00' || '-' || '00000' || '-' || '0') ELSE (AGXOPE3002 || '-' || lpad (NAXOPE3002,2,'0') || '-' || lpad (ORXOPE3002,5,'0') || '-' || KLXOPE3002) END CPT, MNTOPE3002, AGXOPE3002, AGYOPE3002, AGZREC3002, MEGOPE3002, ECHOPE3002, ENGOPE3002, DSCOPE3002, USROPE3002, NOMRSC, LIBOPE
FROM FL1000, FL1030, FL5520 WHERE SU3002=0 and
(CODOPE3002='T009' or CODOPE3002='T010' or CODOPE3002='T016' or CODOPE3002='T017' or CODOPE3002='T018' or CODOPE3002='T019' or CODOPE3002='T039' or CODOPE3002='T021' or CODOPE3002='T036' or CODOPE3002='T092' or CODOPE3002='T059' or CODOPE3002='T060' or CODOPE3002='T061' or CODOPE3002='T062') and
AGXOPE3002=CODAGC1030 and NAXOPE3002=CODNAT1030 and
ORXOPE3002=ORDCPT1030 and KLXOPE3002=KLECPT1030 and
CODOPE3002=CODOPE)
union
(SELECT DATOPE3002, CATOPE3002, CODOPE3002, AGCNUM3002 || ' ' || SERNUM3002 || ' ' || lpad (ORDNUM3002,7,'0'),
CASE  WHEN (NAXOPE3002='' or NAXOPE3002 is null) THEN (AGXOPE3002 || '-' || '00' || '-' || '00000' || '-' || '0') ELSE (AGXOPE3002 || '-' || lpad (NAXOPE3002,2,'0') || '-' || lpad (ORXOPE3002,5,'0') || '-' || KLXOPE3002) END CPT, MNTOPE3002, AGXOPE3002, AGYOPE3002, AGZREC3002, MEGOPE3002, ECHOPE3002, ENGOPE3002, DSCOPE3002, USROPE3002, 'INEXISTANT', LIBOPE
FROM FL1000, FL5520 WHERE SU3002=0 and
(CODOPE3002='T037' or CODOPE3002='T040' or CODOPE3002='T059' or CODOPE3002='T060' or CODOPE3002='T061' or CODOPE3002='T062') and
CODOPE3002=CODOPE and ( (AGXOPE3002 || lpad (NAXOPE3002,2,'0') || lpad (ORXOPE3002,5,'0') || KLXOPE3002) not in (select (CODAGC1030 || lpad (CODNAT1030,2,'0') || lpad (ORDCPT1030,5,'0') || KLECPT1030) from FL1030)))
ORDER BY DATOPE3002, CATOPE3002, CODOPE3002, CPT]]>
	</queryString>
	<field name="DATOPE3002" class="java.sql.Timestamp"/>
	<field name="CATOPE3002" class="java.math.BigDecimal"/>
	<field name="CODOPE3002" class="java.lang.String"/>
	<field name="AGCNUM3002||||SERNUM3002||||LPAD(ORDNUM3002,7,0)" class="java.lang.String"/>
	<field name="CPT" class="java.lang.String"/>
	<field name="MNTOPE3002" class="java.lang.Double"/>
	<field name="AGXOPE3002" class="java.lang.String"/>
	<field name="AGYOPE3002" class="java.lang.String"/>
	<field name="AGZREC3002" class="java.lang.String"/>
	<field name="MEGOPE3002" class="java.lang.String"/>
