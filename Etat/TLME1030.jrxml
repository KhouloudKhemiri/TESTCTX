	<queryString>
		<![CDATA[SELECT SU1030M, CODAGC1030M, CODAGC1030M || '-' || lpad (CODNAT1030M,2,'0') || '-' ||
lpad (ORDCPT1030M,5,'0') || '-' || KLECPT1030M, NOMRSCM, SLCCPT10M, ADRPRSM, CODPTT1030AM, CATCLT1030M,
CODDOC1030M || ' ' ||  ORDDOC1030M, OUVCPT10M, PTTRGC30M, lpad (NUMANL10M,6,'0'),
INDRCS10M || ' ' || INFRCS10M || ' ' || NUMRCS10M || ' ' || ANNRCS10M, CODOPE29M, LIB5503, LIBPTT
FROM ME1030, FL5503, FL5501
WHERE  (CODOPE29M='T101' or CODOPE29M='T102' or CODOPE29M='T103' or CODOPE29M='T044') and CODAGC1030M=CODAGC5503 and CODPTT1030AM=CODPTT
ORDER BY CODOPE29M, CODAGC1030M]]>
	</queryString>
	<field name="SU1030M" class="java.lang.String"/>
	<field name="CODAGC1030M" class="java.lang.String"/>
	<field name="CODAGC1030M||-||LPAD(CODNAT1030M,2,0)||-||LPAD(ORDCPT1030M,5,0)||-||KLECPT1030M" class="java.lang.String"/>
