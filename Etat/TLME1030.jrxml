		<variableExpression><![CDATA[$F{SU1030M}.compareTo("C")==0 ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="NBRMOD" class="java.lang.Integer" resetType="Group" resetGroup="Groupe_AGC" calculation="Sum">
		<variableExpression><![CDATA[$F{SU1030M}.compareTo("M")==0 ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="NBRSUP" class="java.lang.Integer" resetType="Group" resetGroup="Groupe_AGC" calculation="Sum">
		<variableExpression><![CDATA[$F{SU1030M}.compareTo("S")==0 ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="NBRREA" class="java.lang.Integer" resetType="Group" resetGroup="Groupe_AGC" calculation="Sum">
		<variableExpression><![CDATA[$F{SU1030M}.compareTo("R")==0 ? 1 : 0]]></variableExpression>
	</variable>
