	<queryString>
		<![CDATA[SELECT
     DATMEG95,AGCNUM95,SERNUM95,ORDNUM95,
     MNTOPE95,DSCOPE95,AGCEMT95,REFBAS95
FROM
     FL3195
WHERE
     SU3195 = 0
     and NATOPE95 = 'DBI'
ORDER BY
     DATMEG95 ASC,
     AGCEMT95 ASC,
     MNTOPE95 ASC]]>
	</queryString>
