	<queryString>
		<![CDATA[select CATOPEW, CODDST2W, MNTOPEW,  SGNMNTW, substr(lpad (ORDNUMW,7,'0'),2,6), BAQOPEW, AGCNUMW || ' ' || SERNUMW || ' ' ||  lpad (ORDNUMW,7,'0'), RESEFFW, DSCOPEW, BNFOPEW, AGYOPEW || ' ' || lpad (NAYOPEW,2,'0') || ' ' || lpad (ORYOPEW,5,'0') || ' ' || KLYOPEW,RESEFFW,  LIB5503
from  FW3000, FL5503
where CODDST2W=CODAGC5503
order by CODETAW, DATOPEW, CODDST2W, CATOPEW, BAQOPEW, SGNMNTW]]>
	</queryString>
