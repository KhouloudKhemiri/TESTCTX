	<queryString>
		<![CDATA[(select CODAGC1030, CODAGC1030 || '-' || lpad (CODNAT1030,2,'0') || '-' || lpad (ORDCPT1030,5,'0') || '-' || KLECPT1030, NOMRSC,
sum(CASE  WHEN (SMNTOPE99='-') THEN (MNTOPE99*(-1)) ELSE 0 END), sum(CASE  WHEN (SMNTOPE99='0') THEN MNTOPE99 ELSE 0 END), sum(SLDCPT10)/(count(CODAGC1030 || '-' || lpad (CODNAT1030,2,'0') || '-' || lpad (ORDCPT1030,5,'0') || '-' || KLECPT1030)),
(sum(SLDCPT10)/(count(CODAGC1030 || '-' || lpad (CODNAT1030,2,'0') || '-' || lpad (ORDCPT1030,5,'0') || '-' || KLECPT1030)) - sum(CASE  WHEN (SMNTOPE99='-') THEN (MNTOPE99*(-1)) ELSE 0 END) - sum(CASE  WHEN (SMNTOPE99='0') THEN MNTOPE99 ELSE 0 END))
from FL1030, FL3099
where AGCCPT99=CODAGC1030 and NATCPT99=CODNAT1030 and ORDCPT99=ORDCPT1030 and KLECPT99=KLECPT1030 and SU1030=0
and CODCLO10<>1 and DATOPE99 >= (select ('01' || (substr((select max(DATOPE) from FLDATE),3))) from DUAL)
group by CODAGC1030, CODNAT1030, ORDCPT1030, KLECPT1030, NOMRSC)
union
(select CODAGC1030, CODAGC1030 || '-' || lpad (CODNAT1030,2,'0') || '-' || lpad (ORDCPT1030,5,'0') || '-' || KLECPT1030, NOMRSC,
0, 0, SLDCPT10,SLDCPT10 from FL1030
where COUNT_CPT(CODAGC1030 || lpad (CODNAT1030,2,'0') || lpad (ORDCPT1030,5,'0') || KLECPT1030)=0 and SU1030=0
and CODCLO10<>1)]]>
	</queryString>
	<field name="CODAGC1030" class="java.lang.String"/>
	<field name="CODAGC1030||-||LPAD(CODNAT1030,2,0)||-||LPAD(ORDCPT1030,5,0)||-||KLECPT1030" class="java.lang.String"/>
	<field name="NOMRSC" class="java.lang.String"/>
	<field name="SUM(CASEWHEN(SMNTOPE99=-)THEN(MNTOPE99*(-1))ELSE0END)" class="java.math.BigDecimal"/>
	<field name="SUM(CASEWHEN(SMNTOPE99=0)THENMNTOPE99ELSE0END)" class="java.math.BigDecimal"/>
	<field name="SUM(SLDCPT10)/(COUNT(CODAGC1030||-||LPAD(CODNAT1030,2,0)||-||LPAD(ORDCPT1030,5,0)||-||KLECPT1030))" class="java.math.BigDecimal"/>
	<field name="(SUM(SLDCPT10)/(COUNT(CODAGC1030||-||LPAD(CODNAT1030,2,0)||-||LPAD(ORDCPT1030,5,0)||-||KLECPT1030))-SUM(CASEWHEN(SMNTOPE99=-)THEN(MNTOPE99*(-1))ELSE0END)-SUM(CASEWHEN(SMNTOPE99=0)THENMNTOPE99ELSE0END))" class="java.math.BigDecimal"/>
	<variable name="MNTDBI" class="java.lang.Double">
		<variableExpression><![CDATA[$F{SUM(CASEWHEN(SMNTOPE99=-)THEN(MNTOPE99*(-1))ELSE0END)} * (-1)]]></variableExpression>
	</variable>
	<variable name="SGN_ANCSLD" class="java.lang.String">
		<variableExpression><![CDATA[$F{(SUM(SLDCPT10)/(COUNT(CODAGC1030||-||LPAD(CODNAT1030,2,0)||-||LPAD(ORDCPT1030,5,0)||-||KLECPT1030))-SUM(CASEWHEN(SMNTOPE99=-)THEN(MNTOPE99*(-1))ELSE0END)-SUM(CASEWHEN(SMNTOPE99=0)THENMNTOPE99ELSE0END))} < 0 ? "DB" : ""]]></variableExpression>
	</variable>
	<variable name="SGNSLD" class="java.lang.String">
		<variableExpression><![CDATA[$F{SUM(SLDCPT10)/(COUNT(CODAGC1030||-||LPAD(CODNAT1030,2,0)||-||LPAD(ORDCPT1030,5,0)||-||KLECPT1030))} < 0 ? "DB" : ""]]></variableExpression>
	</variable>
	<variable name="ANCSLD" class="java.lang.Double">
		<variableExpression><![CDATA[$F{(SUM(SLDCPT10)/(COUNT(CODAGC1030||-||LPAD(CODNAT1030,2,0)||-||LPAD(ORDCPT1030,5,0)||-||KLECPT1030))-SUM(CASEWHEN(SMNTOPE99=-)THEN(MNTOPE99*(-1))ELSE0END)-SUM(CASEWHEN(SMNTOPE99=0)THENMNTOPE99ELSE0END))} < 0 ? $F{(SUM(SLDCPT10)/(COUNT(CODAGC1030||-||LPAD(CODNAT1030,2,0)||-||LPAD(ORDCPT1030,5,0)||-||KLECPT1030))-SUM(CASEWHEN(SMNTOPE99=-)THEN(MNTOPE99*(-1))ELSE0END)-SUM(CASEWHEN(SMNTOPE99=0)THENMNTOPE99ELSE0END))} * (-1) : $F{(SUM(SLDCPT10)/(COUNT(CODAGC1030||-||LPAD(CODNAT1030,2,0)||-||LPAD(ORDCPT1030,5,0)||-||KLECPT1030))-SUM(CASEWHEN(SMNTOPE99=-)THEN(MNTOPE99*(-1))ELSE0END)-SUM(CASEWHEN(SMNTOPE99=0)THENMNTOPE99ELSE0END))}]]></variableExpression>
	</variable>
	<variable name="SLDCPT" class="java.lang.Double">
		<variableExpression><![CDATA[$F{SUM(SLDCPT10)/(COUNT(CODAGC1030||-||LPAD(CODNAT1030,2,0)||-||LPAD(ORDCPT1030,5,0)||-||KLECPT1030))} < 0 ? $F{SUM(SLDCPT10)/(COUNT(CODAGC1030||-||LPAD(CODNAT1030,2,0)||-||LPAD(ORDCPT1030,5,0)||-||KLECPT1030))} * (-1) : $F{SUM(SLDCPT10)/(COUNT(CODAGC1030||-||LPAD(CODNAT1030,2,0)||-||LPAD(ORDCPT1030,5,0)||-||KLECPT1030))}]]></variableExpression>
	</variable>
	<variable name="TOT_ANCSLD" class="java.lang.Double" resetType="Group" resetGroup="Groupe_Agence" calculation="Sum">
		<variableExpression><![CDATA[$F{(SUM(SLDCPT10)/(COUNT(CODAGC1030||-||LPAD(CODNAT1030,2,0)||-||LPAD(ORDCPT1030,5,0)||-||KLECPT1030))-SUM(CASEWHEN(SMNTOPE99=-)THEN(MNTOPE99*(-1))ELSE0END)-SUM(CASEWHEN(SMNTOPE99=0)THENMNTOPE99ELSE0END))}]]></variableExpression>
	</variable>
	<variable name="TOTDBI" class="java.lang.Double" resetType="Group" resetGroup="Groupe_Agence" calculation="Sum">
