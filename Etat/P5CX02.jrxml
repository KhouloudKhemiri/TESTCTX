		<variableExpression><![CDATA[$F{SUM(SLDCPT10)/(COUNT(CODAGC1030||-||LPAD(CODNAT1030,2,0)||-||LPAD(ORDCPT1030,5,0)||-||KLECPT1030))}]]></variableExpression>
	</variable>
	<variable name="SGN_TOT_ANCSLD" class="java.lang.String">
		<variableExpression><![CDATA[$V{TOT_ANCSLD} < 0 ? "DB" : ""]]></variableExpression>
	</variable>
