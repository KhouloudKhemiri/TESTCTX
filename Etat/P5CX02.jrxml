	</variable>
	<variable name="TOTCRE" class="java.lang.Double" resetType="Group" resetGroup="Groupe_Agence" calculation="Sum">
		<variableExpression><![CDATA[$F{SUM(CASEWHEN(SMNTOPE99=0)THENMNTOPE99ELSE0END)}]]></variableExpression>
