	<parameter name="PA_TMNTPPL" class="java.lang.Double" isForPrompting="false">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="PA_INTAGC" class="java.lang.Double" isForPrompting="false">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="PA_TINTECH" class="java.lang.Double" isForPrompting="false">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="NUMCPT" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[Saisir le Numéro du Compte sur 10 caractères]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[(select DATOPE98, ABROPE98, AGCNUM98 || ' ' || SERNUM98 || ' ' || lpad (ORDNUM98,7,'0'), SMNTOPE98, MNTOPE98, SLDCPT10
from FL3098, FL1030 where
CODAGC1030=substr($P{NUMCPT},1,2) and CODNAT1030=substr($P{NUMCPT},3,2) and ORDCPT1030=substr($P{NUMCPT},5,5) and KLECPT1030=substr($P{NUMCPT},10,1) and
AGCCPT98=substr($P{NUMCPT},1,2) and NATCPT98=substr($P{NUMCPT},3,2) and ORDCPT98=substr($P{NUMCPT},5,5) and KLECPT98=substr($P{NUMCPT},10,1)
and SU3098=0)
union
(select DATOPE99, ABROPE99, AGCNUM99 || ' ' || SERNUM99 || ' ' || lpad (ORDNUM99,7,'0'), SMNTOPE99, MNTOPE99, SLDCPT10
from FL3099, FL1030 where
CODAGC1030=substr($P{NUMCPT},1,2) and CODNAT1030=substr($P{NUMCPT},3,2) and ORDCPT1030=substr($P{NUMCPT},5,5) and KLECPT1030=substr($P{NUMCPT},10,1) and
AGCCPT99=substr($P{NUMCPT},1,2) and NATCPT99=substr($P{NUMCPT},3,2) and ORDCPT99=substr($P{NUMCPT},5,5) and KLECPT99=substr($P{NUMCPT},10,1)
and SU3099=0)
union
(select null, '', '', '', 0, SLDCPT10 from FL1030
where CODAGC1030=substr($P{NUMCPT},1,2) and CODNAT1030=substr($P{NUMCPT},3,2) and ORDCPT1030=substr($P{NUMCPT},5,5) and KLECPT1030=substr($P{NUMCPT},10,1) and not exists (select * from FL3099 where AGCCPT99=substr($P{NUMCPT},1,2) and NATCPT99=substr($P{NUMCPT},3,2) and ORDCPT99=substr($P{NUMCPT},5,5) and KLECPT99=substr($P{NUMCPT},10,1)
and SU3099=0) and  SU1030=0 and CODCLO10<>1)]]>
	</queryString>
	<field name="DATOPE98" class="java.sql.Timestamp"/>
	<field name="ABROPE98" class="java.lang.String"/>
	<field name="AGCNUM98||||SERNUM98||||LPAD(ORDNUM98,7,0)" class="java.lang.String"/>
	<field name="SMNTOPE98" class="java.lang.String"/>
	<field name="MNTOPE98" class="java.math.BigDecimal"/>
	<field name="SLDCPT10" class="java.lang.Double"/>
	<variable name="VA_MONTPE98" class="java.lang.Double">
		<variableExpression><![CDATA[Math.abs($F{MNTOPE98})]]></variableExpression>
	</variable>
	<variable name="TOTDBI" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{SMNTOPE98}.compareTo("-")==0 ? $V{VA_MONTPE98} : 0]]></variableExpression>
	</variable>
	<variable name="TOTCRE" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{SMNTOPE98}.compareTo("0")==0 ? $V{VA_MONTPE98} : 0]]></variableExpression>
	</variable>
	<variable name="VA_SLDCPT10" class="java.lang.Double">
		<variableExpression><![CDATA[Math.abs($F{SLDCPT10})]]></variableExpression>
	</variable>
	<variable name="SLDPRO" class="java.lang.Double">
		<variableExpression><![CDATA[($F{SLDCPT10}.compareTo(0)<0) ?
($P{PA_TMNTPPL} + $P{PA_INTAGC} - $F{SLDCPT10}) :
( (  ($F{SLDCPT10}.compareTo(0)>0  || $F{SLDCPT10}.compareTo(0)==0) && ($F{SLDCPT10}.compareTo($P{PA_TMNTPPL} + $P{PA_INTAGC})>0)) ?
  ($F{SLDCPT10} - $P{PA_TMNTPPL} - $P{PA_INTAGC}) :
   ( (($F{SLDCPT10}.compareTo(0)>0 || $F{SLDCPT10}.compareTo(0)==0) && ($F{SLDCPT10}.compareTo($P{PA_TMNTPPL} + $P{PA_INTAGC})<0 || $F{SLDCPT10}.compareTo($P{PA_TMNTPPL} + $P{PA_INTAGC})==0)) ?
     ($P{PA_TMNTPPL} + $P{PA_INTAGC} - $F{SLDCPT10}) : 0 ) )]]></variableExpression>
	</variable>
	<variable name="INTPFC" class="java.lang.Double">
		<variableExpression><![CDATA[$P{PA_TINTECH} - $P{PA_INTAGC}]]></variableExpression>
	</variable>
	<variable name="SLDPRO_1" class="java.lang.Double">
		<variableExpression><![CDATA[$P{PA_TMNTPPL} + $P{PA_INTAGC} - $F{SLDCPT10}]]></variableExpression>
	</variable>
	<variable name="TSGNSLD" class="java.lang.String">
		<variableExpression><![CDATA[(($F{SLDCPT10}.compareTo(0)>0  || $F{SLDCPT10}.compareTo(0)==0) && ($F{SLDCPT10}.compareTo($P{PA_TMNTPPL} + $P{PA_INTAGC})>0)) ?
  "CREDITEUR" : ""]]></variableExpression>
	</variable>
