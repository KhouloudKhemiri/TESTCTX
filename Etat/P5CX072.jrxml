&& ($F{ECHU66}.compareTo(1)==0))
  ? $F{MNTOPE66} : 0]]></variableExpression>
	</variable>
	<variable name="INTAGC" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[(((($F{PPLINT66}.compareTo(1)==0) && ($F{PFCAGC66}.compareTo(0)==0)) ||
