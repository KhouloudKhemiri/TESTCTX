  (($F{PPLINT66}.compareTo(2)==0) && ($F{PFCAGC66}.compareTo(0)==0)))
 && ($F{ECHU66}.compareTo(1)==0)
 && ($F{SANEFF66}.compareTo(1)==0)) ? $F{MNTOPE66} : 0]]></variableExpression>
	</variable>
	<variable name="TMNTPPL" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[(((($F{PPLINT66}.compareTo(1)!=0) || ($F{PFCAGC66}.compareTo(1)!=0)) &&
