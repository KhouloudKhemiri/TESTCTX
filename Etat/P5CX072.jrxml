	<parameter name="NUMCPT" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[Saisir le Numéro du Compte sur 10 caractères]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[select ROWNUM, AGCNUM66 || ' ' || SERNUM66 || ' ' || lpad (ORDNUM66,7,'0'), ENGOPE66, MNTOPE66, ECHOPE66, PPLINT66, ECHU66, PFCAGC66, SANEFF66 from FL1066 where
CPTAGC66=substr($P{NUMCPT},1,2) and
CPTNAT66=substr($P{NUMCPT},3,2) and
CPTORD66=substr($P{NUMCPT},5,5) and
CPTCLE66=substr($P{NUMCPT},10,1) and
SU1066=0]]>
	</queryString>
	<field name="ROWNUM" class="java.math.BigDecimal"/>
	<field name="AGCNUM66||||SERNUM66||||LPAD(ORDNUM66,7,0)" class="java.lang.String"/>
	<field name="ENGOPE66" class="java.lang.String"/>
	<field name="MNTOPE66" class="java.lang.Double"/>
	<field name="ECHOPE66" class="java.sql.Timestamp"/>
	<field name="PPLINT66" class="java.math.BigDecimal"/>
	<field name="ECHU66" class="java.math.BigDecimal"/>
	<field name="PFCAGC66" class="java.math.BigDecimal"/>
	<field name="SANEFF66" class="java.math.BigDecimal"/>
	<variable name="MNTPPLA" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[(((($F{PPLINT66}.compareTo(1)!=0) || ($F{PFCAGC66}.compareTo(1)!=0)) &&
  (($F{PPLINT66}.compareTo(2)!=0) || ($F{PFCAGC66}.compareTo(1)!=0)) &&
  (($F{PPLINT66}.compareTo(1)!=0) || ($F{PFCAGC66}.compareTo(0)!=0)) &&
  (($F{PPLINT66}.compareTo(2)!=0) || ($F{PFCAGC66}.compareTo(0)!=0)))
 && ($F{SANEFF66}.compareTo(1)!=0)) ? $F{MNTOPE66} : 0]]></variableExpression>
	</variable>
	<variable name="INTECHA" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[(((($F{PPLINT66}.compareTo(1)==0) && ($F{PFCAGC66}.compareTo(1)==0)) ||
  (($F{PPLINT66}.compareTo(2)==0) && ($F{PFCAGC66}.compareTo(1)==0)) ||
  (($F{PPLINT66}.compareTo(1)==0) && ($F{PFCAGC66}.compareTo(0)==0)) ||
  (($F{PPLINT66}.compareTo(2)==0) && ($F{PFCAGC66}.compareTo(0)==0)))
 && ($F{ECHU66}.compareTo(1)!=0)
 && ($F{SANEFF66}.compareTo(1)!=0)) ? $F{MNTOPE66} : 0]]></variableExpression>
	</variable>
	<variable name="INTNECHA" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[(((($F{PPLINT66}.compareTo(1)==0) && ($F{PFCAGC66}.compareTo(1)==0)) ||
  (($F{PPLINT66}.compareTo(2)==0) && ($F{PFCAGC66}.compareTo(1)==0)) ||
  (($F{PPLINT66}.compareTo(1)==0) && ($F{PFCAGC66}.compareTo(0)==0)) ||
  (($F{PPLINT66}.compareTo(2)==0) && ($F{PFCAGC66}.compareTo(0)==0)))
 && ($F{ECHU66}.compareTo(1)==0)
 && ($F{SANEFF66}.compareTo(1)!=0)) ? $F{MNTOPE66} : 0]]></variableExpression>
	</variable>
	<variable name="MNTPPLS" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[(((($F{PPLINT66}.compareTo(1)!=0) || ($F{PFCAGC66}.compareTo(1)!=0)) &&
  (($F{PPLINT66}.compareTo(2)!=0) || ($F{PFCAGC66}.compareTo(1)!=0)) &&
  (($F{PPLINT66}.compareTo(1)!=0) || ($F{PFCAGC66}.compareTo(0)!=0)) &&
  (($F{PPLINT66}.compareTo(2)!=0) || ($F{PFCAGC66}.compareTo(0)!=0)))
 && ($F{SANEFF66}.compareTo(1)==0)) ? $F{MNTOPE66} : 0]]></variableExpression>
	</variable>
	<variable name="INTECHS" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[(((($F{PPLINT66}.compareTo(1)==0) && ($F{PFCAGC66}.compareTo(1)==0)) ||
  (($F{PPLINT66}.compareTo(2)==0) && ($F{PFCAGC66}.compareTo(1)==0)) ||
