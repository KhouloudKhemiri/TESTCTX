	<field name="LIB5503" class="java.lang.String"/>
	<field name="LIBDGL" class="java.lang.String"/>
	<variable name="LIBOPE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[($F{CODOPE19}.equals("T007") || $F{CODOPE19}.equals("T008")) ? $F{LIBOPE29} : ( ($F{CODOPE19}.equals("T087") || $F{CODOPE19}.equals("T088") || $F{CODOPE19}.equals("T089") || $F{CODOPE19}.equals("T090")) ? $F{LIBOPE19} : "" )]]></variableExpression>
	</variable>
	<variable name="CPTGEN" class="java.lang.String">
		<variableExpression><![CDATA[($F{CODOPE19}.equals("T007") || $F{CODOPE19}.equals("T008")) ? $F{AGXOPE19}+" "+$F{ORXOPE19} : ( ($F{CODOPE19}.equals("T089") || $F{CODOPE19}.equals("T090")) ? $F{AGXOPE19}+" "+$F{CGLOPE19} : "" )]]></variableExpression>
	</variable>
	<variable name="MNTOPE" class="java.lang.Double">
		<variableExpression><![CDATA[($F{CODOPE19}.equals("T007") || $F{CODOPE19}.equals("T087") || $F{CODOPE19}.equals("T088") || $F{CODOPE19}.equals("T089") || $F{CODOPE19}.equals("T090")) ? $F{MNTDBI19} : ( $F{CODOPE19}.equals("T008")  ? $F{MNTCRE19} : "" )]]></variableExpression>
	</variable>
	<variable name="AGCRCP" class="java.lang.String">
		<variableExpression><![CDATA[($F{CODOPE19}.equals("T007") || $F{CODOPE19}.equals("T008")) ? $F{AGXOPE19} : ( ($F{CODOPE19}.equals("T089") || $F{CODOPE19}.equals("T090")) ? $F{MEGMEG19} : "" )]]></variableExpression>
	</variable>
	<variable name="NBROPE" class="java.lang.Integer" resetType="Group" resetGroup="Groupe_OPE" calculation="Count">
		<variableExpression><![CDATA[$V{REPORT_COUNT}]]></variableExpression>
	</variable>
	<variable name="TOTMNT" class="java.lang.Double" resetType="Group" resetGroup="Groupe_OPE" calculation="Sum">
		<variableExpression><![CDATA[$V{MNTOPE}]]></variableExpression>
	</variable>
	<variable name="LIBDGLS" class="java.lang.String">
		<variableExpression><![CDATA[($F{CODOPE19}.equals("T007") || $F{CODOPE19}.equals("T008") || $F{CODOPE19}.equals("T089") || $F{CODOPE19}.equals("T090")) ? $F{LIBDGL} : ""]]></variableExpression>
	</variable>
	<variable name="MEGOPES" class="java.lang.String">
		<variableExpression><![CDATA[($F{CODOPE19}.equals("T007") || $F{CODOPE19}.equals("T008") || $F{CODOPE19}.equals("T089") || $F{CODOPE19}.equals("T090")) ? $F{MEGOPE19} : ""]]></variableExpression>
	</variable>
	<variable name="REFOPE" class="java.lang.String">
		<variableExpression><![CDATA[($F{CODOPE19}.equals("T087") || $F{CODOPE19}.equals("T088") || $F{CODOPE19}.equals("T089") || $F{CODOPE19}.equals("T090")) ? $F{REFOPE19} : ($F{CODOPE19}.equals("T007") || $F{CODOPE19}.equals("T008") ? $F{AGCOPE19||SEROPE19||LPAD(ORDOPE19,7,0)} : "")]]></variableExpression>
	</variable>
	<variable name="NBRAGC" class="java.lang.Integer" resetType="Group" resetGroup="Group-AGC" calculation="Count">
		<variableExpression><![CDATA[$V{REPORT_COUNT}]]></variableExpression>
	</variable>
	<variable name="TOTDBIAGC" class="java.lang.Double" resetType="Group" resetGroup="Group-AGC" calculation="Sum">
		<variableExpression><![CDATA[$F{CODOPE19}.equals("T007") || $F{CODOPE19}.equals("T087") || $F{CODOPE19}.equals("T089") ? $V{MNTOPE} : 0]]></variableExpression>
	</variable>
	<variable name="TOTCREAGC" class="java.lang.Double" resetType="Group" resetGroup="Group-AGC" calculation="Sum">
		<variableExpression><![CDATA[$F{CODOPE19}.equals("T008") || $F{CODOPE19}.equals("T088") || $F{CODOPE19}.equals("T090") ? $V{MNTOPE} : 0]]></variableExpression>
	</variable>
	<variable name="TOTDBIGEN" class="java.lang.Double" calculation="Sum">
