	</variable>
	<variable name="TOTCREGEN" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{CODOPE19}.equals("T008") || $F{CODOPE19}.equals("T088") || $F{CODOPE19}.equals("T090") ? $V{MNTOPE} : 0]]></variableExpression>
	</variable>
	<variable name="NBRTOT" class="java.lang.Integer" calculation="Count">
