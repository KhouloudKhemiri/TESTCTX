	<queryString>
		<![CDATA[(SELECT CODOPE19, REFOPE19, AGCOPE19, SEROPE19, ORDOPE19, AGCOPE19 || SEROPE19 || lpad (ORDOPE19,7,'0'), AGXOPE19, NAXOPE19, ORXOPE19, KLXOPE19, CGLOPE19,
CASE  WHEN (CODOPE19='T089' or CODOPE19='T090') THEN (AGYOPE19 || '-' || lpad (NAYOPE19,2,'0') || '-' || lpad (ORYOPE19,5,'0') || '-' || KLYOPE19) ELSE '' END,
      NOMRSC, MNTDBI19, MNTCRE19, LIBOPE19, LIBOPE29, MEGOPE19, MEGMEG19, USROPE19, LIBOPE, LIB5503, LIBDGL
 FROM FL1019, FL1030, FL5520, FL5503, FL1041 WHERE SU1019=0 and (CODOPE19='T089' or CODOPE19='T090')
and CODAGC1030 = (CASE WHEN (CODOPE19='T089' or CODOPE19='T090') THEN AGYOPE19
                  ELSE null END)
and CODNAT1030 = (CASE WHEN (CODOPE19='T089' or CODOPE19='T090') THEN NAYOPE19
                  ELSE null END)
and ORDCPT1030 = (CASE WHEN (CODOPE19='T089' or CODOPE19='T090') THEN ORYOPE19
                  ELSE null END)
and KLECPT1030 = (CASE WHEN (CODOPE19='T089' or CODOPE19='T090') THEN KLYOPE19
                  ELSE null END)
and CODCGL1041 = CGLOPE19
and  CODOPE19=CODOPE and AGXOPE19=CODAGC5503)
union
(SELECT CODOPE19, REFOPE19, AGCOPE19, SEROPE19, ORDOPE19, AGCOPE19 || SEROPE19 || lpad (ORDOPE19,7,'0'), AGXOPE19, NAXOPE19, ORXOPE19, KLXOPE19, CGLOPE19,
CASE  WHEN (CODOPE19='T089' or CODOPE19='T090') THEN (AGYOPE19 || '-' || lpad (NAYOPE19,2,'0') || '-' || lpad (ORYOPE19,5,'0') || '-' || KLYOPE19) ELSE '' END,
      '', MNTDBI19, MNTCRE19, LIBOPE19, LIBOPE29, MEGOPE19, MEGMEG19, USROPE19, LIBOPE, LIB5503, LIBDGL
 FROM FL1019, FL5520, FL5503, FL1041 WHERE SU1019=0 and (CODOPE19='T089' or CODOPE19='T090')
and AGYOPE19 is null and NAYOPE19 is null and ORYOPE19 is null and KLYOPE19 is null
and CODCGL1041 = CGLOPE19
and  CODOPE19=CODOPE and AGXOPE19=CODAGC5503)
union
(SELECT CODOPE19, REFOPE19, AGCOPE19, SEROPE19, ORDOPE19, AGCOPE19 || SEROPE19 || lpad (ORDOPE19,7,'0'), AGXOPE19, NAXOPE19, ORXOPE19, KLXOPE19, CGLOPE19,
CASE WHEN (CODOPE19='T087' or CODOPE19='T088') THEN (AGXOPE19 || '-' || lpad (NAXOPE19,2,'0') || '-' || lpad (ORXOPE19,5,'0') || '-' || KLXOPE19) ELSE '' END,
      NOMRSC, MNTDBI19, MNTCRE19, LIBOPE19, LIBOPE29, MEGOPE19, MEGMEG19, USROPE19, LIBOPE, LIB5503, ''
 FROM FL1019, FL1030, FL5520, FL5503 WHERE SU1019=0 and (CODOPE19='T087' or CODOPE19='T088')
and CODAGC1030 = (CASE WHEN (CODOPE19='T087' or CODOPE19='T088') THEN AGXOPE19
                  ELSE null END)
and CODNAT1030 = (CASE  WHEN (CODOPE19='T087' or CODOPE19='T088') THEN NAXOPE19
                  ELSE null END)
and ORDCPT1030 = (CASE  WHEN (CODOPE19='T087' or CODOPE19='T088') THEN ORXOPE19
                  ELSE null END)
and KLECPT1030 = (CASE  WHEN (CODOPE19='T087' or CODOPE19='T088') THEN KLXOPE19
                  ELSE null END)
and  CODOPE19=CODOPE and AGXOPE19=CODAGC5503)
union
(SELECT CODOPE19, REFOPE19, AGCOPE19, SEROPE19, ORDOPE19, AGCOPE19 || SEROPE19 || lpad (ORDOPE19,7,'0'), AGXOPE19, NAXOPE19, ORXOPE19, KLXOPE19, CGLOPE19, '', '', MNTDBI19, MNTCRE19, LIBOPE19, LIBOPE29, MEGOPE19, MEGMEG19, USROPE19, LIBOPE, LIB5503, LIBDGL
FROM FL1019, FL5520, FL5503, FL1041 WHERE SU1019=0 and (CODOPE19='T007' or CODOPE19='T008')
and CODCGL1041 = ORXOPE19
and  CODOPE19=CODOPE and AGXOPE19=CODAGC5503)
order by AGXOPE19, CODOPE19, NAXOPE19, ORXOPE19, KLXOPE19, CGLOPE19, AGCOPE19, SEROPE19, ORDOPE19]]>
	</queryString>
	<field name="CODOPE19" class="java.lang.String"/>
	<field name="REFOPE19" class="java.math.BigDecimal"/>
	<field name="AGCOPE19" class="java.lang.String"/>
	<field name="SEROPE19" class="java.lang.String"/>
	<field name="ORDOPE19" class="java.math.BigDecimal"/>
	<field name="AGCOPE19||SEROPE19||LPAD(ORDOPE19,7,0)" class="java.lang.String"/>
	<field name="AGXOPE19" class="java.lang.String"/>
	<field name="NAXOPE19" class="java.math.BigDecimal"/>
	<field name="ORXOPE19" class="java.math.BigDecimal"/>
	<field name="KLXOPE19" class="java.math.BigDecimal"/>
	<field name="CGLOPE19" class="java.math.BigDecimal"/>
	<field name="CASEWHEN(CODOPE19=T089ORCODOPE19=T090)THEN(AGYOPE19||-||LPAD(NAYOPE19,2,0)||-||LPAD(ORYOPE19,5,0)||-||KLYOPE19)ELSEEND" class="java.lang.String"/>
	<field name="NOMRSC" class="java.lang.String"/>
	<field name="MNTDBI19" class="java.lang.Double"/>
	<field name="MNTCRE19" class="java.lang.Double"/>
	<field name="LIBOPE19" class="java.lang.String"/>
