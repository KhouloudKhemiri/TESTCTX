	<parameter name="NUMCPT" class="java.lang.String">
		<parameterDescription><![CDATA[Saisir le Numéro du Compte sur 10 caractères]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="DATEXT" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[(select SU3098, DATOPE98, CODOPE98, AGCNUM98, SERNUM98, ORDNUM98, AGCNUM98 || ' ' || SERNUM98 || ' ' || lpad (ORDNUM98,7,'0'), NUMORD98, AGCCPT98, NATCPT98, ORDCPT98, KLECPT98, ABROPE98, SMNTOPE98, MNTOPE98, SLDCPT10, NOMRSC, ADRPRS from FL3098, FL1030 where
SU3098=0 and
CODAGC1030=substr($P{NUMCPT},1,2) and
CODNAT1030=substr($P{NUMCPT},3,2) and
ORDCPT1030=substr($P{NUMCPT},5,5) and
KLECPT1030=substr($P{NUMCPT},10,1) and
AGCCPT98 = CODAGC1030  and NATCPT98 = CODNAT1030 and
ORDCPT98 = ORDCPT1030  and KLECPT98 = KLECPT1030  and (DATOPE98 >= (CASE  WHEN ($P{DATEXT} is null ) THEN (to_date('01/01/2000')) ELSE to_date($P{DATEXT},'dd/mm/yyyy') END)))
union
(select SU3099, DATOPE99, CODOPE99, AGCNUM99, SERNUM99, ORDNUM99, AGCNUM99 || ' ' || SERNUM99 || ' ' || lpad (ORDNUM99,7,'0'), NUMORD99, AGCCPT99, NATCPT99, ORDCPT99, KLECPT99, ABROPE99, SMNTOPE99, MNTOPE99, SLDCPT10, NOMRSC, ADRPRS from FL3099, FL1030 where
--SU3099=0 and
CODAGC1030=substr($P{NUMCPT},1,2) and
CODNAT1030=substr($P{NUMCPT},3,2) and
ORDCPT1030=substr($P{NUMCPT},5,5) and
KLECPT1030=substr($P{NUMCPT},10,1) and
AGCCPT99(+)=CODAGC1030 and NATCPT99(+)=CODNAT1030 and
ORDCPT99(+)=ORDCPT1030 and KLECPT99(+)=KLECPT1030  and (DATOPE99(+) >= (CASE  WHEN ($P{DATEXT} is null ) THEN (to_date('01/01/2000')) ELSE to_date($P{DATEXT},'dd/mm/yyyy') END)))
order by DATOPE98, CODOPE98, AGCNUM98, SERNUM98, ORDNUM98, NUMORD98]]>
	</queryString>
	<field name="SU3098" class="java.math.BigDecimal"/>
	<field name="DATOPE98" class="java.sql.Timestamp"/>
	<field name="CODOPE98" class="java.lang.String"/>
	<field name="AGCNUM98" class="java.lang.String"/>
	<field name="SERNUM98" class="java.lang.String"/>
	<field name="ORDNUM98" class="java.math.BigDecimal"/>
	<field name="AGCNUM98||||SERNUM98||||LPAD(ORDNUM98,7,0)" class="java.lang.String"/>
	<field name="NUMORD98" class="java.math.BigDecimal"/>
	<field name="AGCCPT98" class="java.lang.String"/>
	<field name="NATCPT98" class="java.math.BigDecimal"/>
	<field name="ORDCPT98" class="java.math.BigDecimal"/>
	<field name="KLECPT98" class="java.math.BigDecimal"/>
	<field name="ABROPE98" class="java.lang.String"/>
	<field name="SMNTOPE98" class="java.lang.String"/>
	<field name="MNTOPE98" class="java.lang.Double"/>
	<field name="SLDCPT10" class="java.lang.Double"/>
	<field name="NOMRSC" class="java.lang.String"/>
	<field name="ADRPRS" class="java.lang.String"/>
	<variable name="MNTDBI" class="java.lang.Double">
		<variableExpression><![CDATA[$F{SMNTOPE98}.compareTo("-")==0 ? $F{MNTOPE98} : 0]]></variableExpression>
	</variable>
	<variable name="MNTCRE" class="java.lang.Double">
		<variableExpression><![CDATA[$F{SMNTOPE98}.compareTo("0")==0 ? $F{MNTOPE98} : 0]]></variableExpression>
	</variable>
	<variable name="TOTMVT" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$V{MNTCRE} - $V{MNTDBI}]]></variableExpression>
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
	<variable name="SLDDEP" class="java.lang.Double">
		<variableExpression><![CDATA[$F{SLDCPT10} - $V{TOTMVT}]]></variableExpression>
	</variable>
