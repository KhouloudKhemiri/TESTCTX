FROM FL1000, FL5520 WHERE SU3002=0 and
(CODOPE3002='T035' or CODOPE3002='T038') and CODOPE3002=CODOPE
ORDER BY DATOPE3002, CATOPE3002, CODOPE3002, AGZREC3002]]>
	</queryString>
