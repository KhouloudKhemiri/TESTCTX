	<queryString>
		<![CDATA[SELECT AGCNUM73 || ' ' || SERNUM73 || ' ' || lpad (ORDNUM73,7,'0'),
       CPTAGC73 || '-' || lpad (CPTNAT73,2,'0') || '-' ||
       lpad (CPTORD73,5,'0') || '-' || CPTCLE73,
       NOMCPT73,MNTOPE73,DATFLC73,ECHOPE73,ENGOPE73
FROM FL1073
WHERE SU1073 = 0
ORDER BY CPTAGC73, CPTNAT73,CPTORD73 , CPTCLE73, ENGOPE73, ECHOPE73, DATFLC73, AGCNUM73, SERNUM73,
ORDNUM73]]>
	</queryString>
