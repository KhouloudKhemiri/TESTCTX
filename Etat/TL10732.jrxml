	<queryString>
		<![CDATA[SELECT  ENGOPE73, LIBENG7063, count(ENGOPE73), sum(MNTOPE73) FROM FL1073, FL7063 where ENGOPE73=CODENG7063 group by ENGOPE73, LIBENG7063 order by ENGOPE73]]>
