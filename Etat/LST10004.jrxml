	<queryString>
		<![CDATA[SELECT CODOPE3002, AGCNUM3002 || ' ' || SERNUM3002 || ' ' ||
lpad (ORDNUM3002,7,'0'), AGXOPE3002 || '-' || lpad (NAXOPE3002,2,'0') || '-' || lpad (ORXOPE3002,5,'0') || '-' || KLXOPE3002, NOMRSC, MNTOPE3002, FRAOPE3002, INTPRE3002, INTCOU3002, COMOPE3002, MNTCHG3002, ENGOPE3002, ECHOPE3002, PPLINT3002, USROPE3002, LIBOPE
FROM FL1000, FL1030, FL5520 WHERE SU3002=0 and (CODOPE3002='T031') and
AGXOPE3002=CODAGC1030 and NAXOPE3002=CODNAT1030 and
ORXOPE3002=ORDCPT1030 and KLXOPE3002=KLECPT1030 and CODOPE3002=CODOPE
ORDER BY DATOPE3002, CATOPE3002, CODOPE3002, AGXOPE3002, NAXOPE3002, ORXOPE3002, KLXOPE3002]]>
	</queryString>
