	<parameter name="NUMCPT" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[Saisir le Numéro du Compte sur 10 caractères]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select AGCNUM73 || ' ' || SERNUM73 || ' ' || lpad (ORDNUM73,7,'0'), ENGOPE73, MNTOPE73, ECHOPE73, NOMRSC, ADRPRS from FL1073, FL1030 where
CPTAGC73=substr($P{NUMCPT},1,2) and
CPTNAT73=substr($P{NUMCPT},3,2) and
CPTORD73=substr($P{NUMCPT},5,5) and
CPTCLE73=substr($P{NUMCPT},10,1) and
CODAGC1030=substr($P{NUMCPT},1,2) and
CODNAT1030=substr($P{NUMCPT},3,2) and
ORDCPT1030=substr($P{NUMCPT},5,5) and
KLECPT1030=substr($P{NUMCPT},10,1) and
SU1073=0]]>
	</queryString>
	<field name="AGCNUM73||||SERNUM73||||LPAD(ORDNUM73,7,0)" class="java.lang.String"/>
	<field name="ENGOPE73" class="java.lang.String"/>
	<field name="MNTOPE73" class="java.lang.Double"/>
